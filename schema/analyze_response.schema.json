{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "원본 이미지 픽셀 좌표, 좌상단~우하단",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "x2": {
          "minimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y2": {
          "minimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBox",
      "type": "object"
    },
    "CodeDecode": {
      "additionalProperties": false,
      "description": "QR · 바코드 디코딩 결과 (label == qr_barcode 일 때만)",
      "properties": {
        "decoded": {
          "title": "Decoded",
          "type": "boolean"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "QR_CODE, EAN_13, CODE_128 ...",
          "title": "Format"
        },
        "payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "디코딩 원문. 응답 직전에 B가 마스킹 처리",
          "title": "Payload"
        }
      },
      "required": [
        "decoded"
      ],
      "title": "CodeDecode",
      "type": "object"
    },
    "ExifInfo": {
      "additionalProperties": false,
      "properties": {
        "present": {
          "description": "EXIF 존재 여부",
          "title": "Present",
          "type": "boolean"
        },
        "gps": {
          "anyOf": [
            {
              "$ref": "#/$defs/GPS"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Make + Model",
          "title": "Device"
        },
        "taken_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taken At"
        },
        "software": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software"
        },
        "orientation": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "원본 Orientation 태그값",
          "title": "Orientation"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        }
      },
      "required": [
        "present",
        "risk"
      ],
      "title": "ExifInfo",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "Detection 에 판독 · 판정 결과를 덧붙인 것 = 최종 결과 한 건",
      "properties": {
        "id": {
          "description": "이미지 내 고유 번호 (A가 0부터 부여)",
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/ObjectLabel"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "det_conf": {
          "description": "YOLO confidence",
          "maximum": 1,
          "minimum": 0,
          "title": "Det Conf",
          "type": "number"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "원근 보정용 네 꼭짓점 (시계방향, 좌상단부터). 없으면 bbox 사용",
          "title": "Polygon"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeDecode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ocr": {
          "anyOf": [
            {
              "$ref": "#/$defs/OCRResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "debug=true 일 때만 응답에 포함"
        },
        "pii": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PIIItem"
          },
          "title": "Pii",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        }
      },
      "required": [
        "id",
        "label",
        "bbox",
        "det_conf",
        "risk"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GPS": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GPS",
      "type": "object"
    },
    "ImageInfo": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "방향 보정 후 가로 픽셀",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "description": "방향 보정 후 세로 픽셀",
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "format": {
          "enum": [
            "jpeg",
            "png",
            "webp",
            "heic"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "width",
        "height",
        "format"
      ],
      "title": "ImageInfo",
      "type": "object"
    },
    "ModelVersions": {
      "additionalProperties": false,
      "properties": {
        "detector": {
          "description": "예: yolov8s-pl-v1 + sahi640",
          "title": "Detector",
          "type": "string"
        },
        "ocr": {
          "title": "Ocr",
          "type": "string"
        },
        "ner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ner"
        }
      },
      "required": [
        "detector",
        "ocr"
      ],
      "title": "ModelVersions",
      "type": "object"
    },
    "OCRLine": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "conf": {
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "줄을 가장 작게 감싸는 회전 사각형 [좌상, 우상, 우하, 좌하]. 기울어진 글자 가림용 (v0.2.0)",
          "title": "Polygon"
        }
      },
      "required": [
        "text",
        "conf",
        "bbox"
      ],
      "title": "OCRLine",
      "type": "object"
    },
    "OCRResult": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "description": "paddleocr-korean / clova / tesseract ...",
          "title": "Engine",
          "type": "string"
        },
        "text": {
          "description": "줄을 \\n 으로 이어붙인 전체 텍스트",
          "title": "Text",
          "type": "string"
        },
        "conf": {
          "description": "줄 conf 의 평균",
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        },
        "lines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OCRLine"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "engine",
        "text",
        "conf"
      ],
      "title": "OCRResult",
      "type": "object"
    },
    "ObjectLabel": {
      "description": "검출 클래스 9종 (YOLO 클래스 인덱스 순서와 동일하게 유지)",
      "enum": [
        "parcel_label",
        "name_tag",
        "student_id",
        "payment_card",
        "screen",
        "license_plate",
        "receipt",
        "document",
        "qr_barcode"
      ],
      "title": "ObjectLabel",
      "type": "string"
    },
    "PIIItem": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/PIIType"
        },
        "value_masked": {
          "description": "화면 표시용 마스킹 값. 예: 010-****-5678",
          "title": "Value Masked",
          "type": "string"
        },
        "method": {
          "enum": [
            "regex",
            "ner",
            "rule",
            "exif",
            "code"
          ],
          "title": "Method",
          "type": "string"
        },
        "conf": {
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "항목이 발견된 줄 위치 → 부분 마스킹에 사용"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "항목을 감싸는 회전 사각형 [좌상, 우상, 우하, 좌하] — 있으면 bbox 대신 이 모양으로 가림 (v0.2.0)",
          "title": "Polygon"
        }
      },
      "required": [
        "type",
        "value_masked",
        "method",
        "conf"
      ],
      "title": "PIIItem",
      "type": "object"
    },
    "PIIType": {
      "description": "판정 단위(항목) — B 모듈이 채움",
      "enum": [
        "person_name",
        "address",
        "phone",
        "rrn",
        "card_number",
        "account_number",
        "student_number",
        "tracking_number",
        "plate_number",
        "email",
        "affiliation",
        "url",
        "gps",
        "device",
        "other"
      ],
      "title": "PIIType",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "factors": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskFactors"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "description": "사용자에게 보여줄 근거 문장",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "score",
        "level",
        "reason"
      ],
      "title": "Risk",
      "type": "object"
    },
    "RiskFactors": {
      "additionalProperties": false,
      "description": "위험도 = type_weight × readability × area_factor (산식은 B가 확정)",
      "properties": {
        "type_weight": {
          "description": "발견된 PII 유형 가중치 중 최댓값",
          "maximum": 1,
          "minimum": 0,
          "title": "Type Weight",
          "type": "number"
        },
        "readability": {
          "description": "판독가능성 (OCR conf · 글자 높이 기반)",
          "maximum": 1,
          "minimum": 0,
          "title": "Readability",
          "type": "number"
        },
        "area_factor": {
          "description": "이미지 대비 영역 크기 보정값",
          "maximum": 1,
          "minimum": 0,
          "title": "Area Factor",
          "type": "number"
        }
      },
      "required": [
        "type_weight",
        "readability",
        "area_factor"
      ],
      "title": "RiskFactors",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/RiskLevel",
          "description": "findings · exif 중 가장 높은 등급"
        },
        "finding_count": {
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "headline": {
          "description": "결과 화면 최상단 문장",
          "title": "Headline",
          "type": "string"
        }
      },
      "required": [
        "level",
        "finding_count",
        "headline"
      ],
      "title": "Summary",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "description": "단계별 소요 시간(ms) — 성공 기준 '5초 이내' 측정용",
      "properties": {
        "total_ms": {
          "minimum": 0,
          "title": "Total Ms",
          "type": "integer"
        },
        "exif_ms": {
          "minimum": 0,
          "title": "Exif Ms",
          "type": "integer"
        },
        "detect_ms": {
          "minimum": 0,
          "title": "Detect Ms",
          "type": "integer"
        },
        "ocr_ms": {
          "minimum": 0,
          "title": "Ocr Ms",
          "type": "integer"
        },
        "judge_ms": {
          "minimum": 0,
          "title": "Judge Ms",
          "type": "integer"
        }
      },
      "required": [
        "total_ms",
        "exif_ms",
        "detect_ms",
        "ocr_ms",
        "judge_ms"
      ],
      "title": "Timing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "image": {
      "$ref": "#/$defs/ImageInfo"
    },
    "exif": {
      "$ref": "#/$defs/ExifInfo"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "timing": {
      "$ref": "#/$defs/Timing"
    },
    "models": {
      "$ref": "#/$defs/ModelVersions"
    }
  },
  "required": [
    "request_id",
    "image",
    "exif",
    "findings",
    "summary",
    "timing",
    "models"
  ],
  "title": "AnalyzeResponse",
  "type": "object"
}