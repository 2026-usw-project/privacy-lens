# Node
node_modules/
dist/
# 화면 소스는 dist 에 있다(빌드 결과가 아니라 편집 원본)
!web/frontend-demo/dist/

# 모델 가중치. models/ 는 드라이브에서 받아 두는 곳(metrics.json 포함, 저장소에 올리지 않음)
*.pt
*.onnx
/models/
runs/
weights/

# https 인증서·개인 키 (run_gateway.py --ssl-cert/--ssl-key, mkcert)
*.pem
*.key

# build.mjs --api 가 만드는 정적 배포 폴더
web/frontend-demo/site/

# run.py / samples/make_sample.py 가 만드는 합성 샘플
samples/out/

# 이미지 데이터 (개인정보 포함 가능 — 절대 커밋 금지)
data/
*.jpg
*.jpeg
*.png
*.heic
!docs/**/*.png

# IDE · 로컬 도구
