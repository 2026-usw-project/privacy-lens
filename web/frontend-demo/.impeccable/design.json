  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "화면당 하나의 다음 행동(분석 시작, 저장, 다운로드).",
      "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v13m-5-5 5 5 5-5M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4\"/></svg>가린 사진 저장하기</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:10px;background:var(--accent,#ef5a1c);color:#fff;font-size:14px;font-weight:600;cursor:pointer;box-shadow:inset 0 1px 0 #ffffff40,0 1px 2px #b23f0b59;transition:background .15s,transform .1s}.ds-btn-primary:hover{background:var(--accent-hover,#b23f0b)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#ef5a1c);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "보조 행동(직접 지정, 취소, 시연 재현).",
      "html": "<button class=\"ds-btn-ghost\">직접 영역 지정하기</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:10px;background:var(--surface-2,#f0efeb);color:var(--ink,#1f1d1a);font-size:14px;font-weight:600;cursor:pointer;transition:background .15s,transform .1s}.ds-btn-ghost:hover{background:var(--surface-3,#e8e6e1)}.ds-btn-ghost:active{transform:translateY(1px)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#ef5a1c);outline-offset:2px}"
    },
    {
      "name": "Top Bar Chip",
      "kind": "chip",
      "refersTo": "chip-button",
      "description": "상단바의 시연·연결 칩. 펼침 상태는 주황 틴트.",
      "html": "<button class=\"ds-chip\">데모 · 서버 미연결</button><button class=\"ds-chip\" aria-expanded=\"true\">발표 시연</button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 12px;margin-right:8px;border:0;border-radius:10px;background:var(--surface-2,#f0efeb);color:var(--ink,#1f1d1a);font-size:13px;font-weight:500;cursor:pointer}.ds-chip:hover{background:var(--surface-3,#e8e6e1)}.ds-chip[aria-expanded=true]{background:var(--accent-tint,#fdede4);color:var(--accent-ink,#b23f0b)}.ds-chip:focus-visible{outline:2px solid var(--accent,#ef5a1c);outline-offset:2px}"
    },
    {
      "name": "Endpoint Input",
      "kind": "input",
      "refersTo": "input-field",
      "description": "주소·좌표 입력. 모노, 진한 헤어라인 테두리.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"http://127.0.0.1:8000\">",
      "css": ".ds-input{width:280px;padding:10px 12px;border:1px solid var(--line-strong,#d4d0c7);border-radius:8px;background:var(--surface,#fdfdfc);color:var(--ink,#1f1d1a);font:14px ui-monospace,Consolas,monospace}.ds-input:focus-visible{outline:2px solid var(--accent,#ef5a1c);outline-offset:2px}"
    },
    {
      "name": "Side Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "사이드바 항목. 활성은 주황 틴트, 개수는 모노.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item active\" href=\"#\">사진 검사</a><a class=\"ds-nav-item\" href=\"#\">탐지 대상<span class=\"ds-count\">9</span></a><a class=\"ds-nav-item\" href=\"#\">이용 안내</a></nav>",
      "css": ".ds-nav{display:grid;gap:2px;width:208px;padding:12px;background:var(--bg,#f7f6f3)}.ds-nav-item{display:flex;align-items:center;height:40px;padding:0 12px;border-radius:8px;font-size:14px;font-weight:500;color:var(--ink-2,#4a4741);text-decoration:none}.ds-nav-item:hover{background:var(--surface-2,#f0efeb);color:var(--ink,#1f1d1a)}.ds-nav-item.active{background:var(--accent-tint,#fdede4);color:var(--accent-ink,#b23f0b)}.ds-nav-item:focus-visible{outline:2px solid var(--accent,#ef5a1c);outline-offset:2px}.ds-count{margin-left:auto;font:12px ui-monospace,Consolas,monospace;color:var(--muted,#6b675f)}"
    },
    {
      "name": "Bracket Status Tag",
      "kind": "chip",
      "refersTo": "risk-tag",
      "description": "제목 옆 같은 줄에 붙는 모노 대괄호 상태 태그.",
      "html": "<h2 class=\"ds-h\">확인이 필요한 정보 <span class=\"ds-tag\">SAMPLE</span></h2>",
      "css": ".ds-h{display:flex;align-items:baseline;gap:10px;margin:0;font-size:18px;font-weight:650;letter-spacing:-.02em;color:var(--ink,#1f1d1a)}.ds-tag{font:500 12px ui-monospace,Consolas,monospace;color:var(--accent-ink,#b23f0b);letter-spacing:0}.ds-tag:before{content:\"[ \"}.ds-tag:after{content:\" ]\"}"
    },
    {
      "name": "Workspace Frame",
      "kind": "card",
      "refersTo": "workspace",
      "description": "흰 작업 면 하나를 헤어라인으로 나누고, 분할선과 테두리가 만나는 곳에 + 표시.",
      "html": "<div class=\"ds-frame\"><div class=\"ds-left\">사진</div><div class=\"ds-right\">결과 목록</div></div>",
      "css": ".ds-frame{position:relative;display:grid;grid-template-columns:1fr 160px;height:160px;border:1px solid var(--line,#e6e3dd);border-radius:12px;background:var(--surface,#fdfdfc);font-size:13px;color:var(--muted,#6b675f)}.ds-frame:before,.ds-frame:after{content:\"\";position:absolute;left:calc(100% - 167px);width:13px;height:13px;background:linear-gradient(#6b675f,#6b675f) center/1px 100% no-repeat,linear-gradient(#6b675f,#6b675f) center/100% 1px no-repeat}.ds-frame:before{top:-7px}.ds-frame:after{bottom:-7px}.ds-left{padding:16px;border-right:1px solid var(--line,#e6e3dd);border-radius:12px 0 0 12px;background:radial-gradient(circle,#d6d2c9 1px,transparent 1.2px) 0 0/14px 14px,var(--bg,#f7f6f3)}.ds-right{padding:16px}"
    },
    {
      "name": "Region List Row",
      "kind": "custom",
      "refersTo": "risk-tag",
      "description": "번호·이름·위험 태그와 근거 문장. 선택된 행은 주황 워시.",
      "html": "<div class=\"ds-row sel\"><div class=\"ds-top\"><input type=\"checkbox\" checked><span class=\"ds-name\"><span class=\"ds-no\">01</span>받는 사람 주소</span><span class=\"ds-risk\">주소</span></div><p class=\"ds-desc\">송장 라벨에 도로명 주소가 보여요.</p></div>",
      "css": ".ds-row{width:340px;padding:10px 20px;border-bottom:1px solid var(--line,#e6e3dd);background:var(--surface,#fdfdfc)}.ds-row.sel,.ds-row:hover{background:var(--accent-wash,#fef6f1)}.ds-top{display:flex;align-items:flex-start;gap:10px}.ds-top input{width:16px;height:16px;margin:3px 0 0;accent-color:var(--accent,#ef5a1c)}.ds-name{flex:1;font-size:14px;font-weight:600;color:var(--ink,#1f1d1a)}.ds-no{margin-right:8px;font:12px ui-monospace,Consolas,monospace;color:var(--muted,#6b675f)}.ds-risk{padding:2px 6px;border-radius:4px;background:var(--accent-tint,#fdede4);font:12px ui-monospace,Consolas,monospace;color:var(--accent-ink,#b23f0b)}.ds-desc{margin:4px 0 0 26px;font-size:13px;line-height:1.6;color:var(--muted,#6b675f)}"
    }
  ],
  "narrative": {
    "northStar": "검수 작업대 (The Inspection Bench)",
    "overview": "**Creative North Star: \"검수 작업대 (The Inspection Bench)\"**\n\n사진 검사는 마케팅 페이지가 아니라 대시보드 안의 한 작업 화면입니다. 웜 오프화이트 바닥 위에 흰 작업 면 하나를 놓고, 그 면을 1px 헤어라인으로 나눠 왼쪽에는 사진, 오른쪽에는 근거 목록과 저장 버튼을 둡니다. 화면 안에서 가장 시끄러운 것은 사진 위의 주황 박스여야 하고, 그 외의 장치는 조용히 물러납니다. 시각 문법은 Firecrawl 대시보드의 스타일만 빌렸고, 이름·로고·불꽃 아이콘은 쓰지 않습니다.\n\n밀도는 데스크톱 도구 수준입니다. 본문은 13~14px, 행 높이는 34~48px, 패널 안쪽 여백은 20px 안팎으로 한 화면에 사진과 목록과 저장 버튼이 함께 들어갑니다. 숫자·좌표·파일 정보·상태는 모노 글꼴의 대괄호 라벨(`[ 가상 데이터 ]` 문법)로, 문장은 한글 산세리프로 씁니다. 깊이는 대부분 선과 면의 명도 차이로 만들고, 그림자는 실제로 떠 있는 물체(입력 막대, 사진, 대화상자, 토스트)에만 붙습니다.\n\n글꼴은 Pretendard(OFL)를 `dist/fonts/`에 자체 호스팅합니다. KS X 1001 한글 서브셋 정적 4종(400·500·600·700, 각 약 270KB)이며 외부 요청은 없습니다(CSP `default-src 'self'`). 라이선스는 `dist/fonts/LICENSE.txt`.",
