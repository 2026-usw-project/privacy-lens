# Privacy Lens 서버 설정 예시. 이 파일을 .env 로 복사해 값을 채웁니다(.env 는 .gitignore 에 있어 커밋되지 않음).
#   cp .env.example .env
# run.py · run_backend.py · run_gateway.py · server.py 가 켤 때 읽습니다(envfile.py).
# 셸에서 이미 준 환경 변수가 이깁니다. 다른 위치의 파일은 PL_ENV_FILE=<경로> 로 지정합니다.
# 값을 바꾸면 서버를 다시 켜야 적용됩니다.

# ---------------------------------------------------------------- 판단 모델 기본값 (D-22)
# 브라우저에 판단 모델 설정을 저장한 적 없는 사용자(처음 온 사용자)는 이 값으로 시작합니다.
# 화면의 API 키 칸을 비워 두면 서버가 아래 키를 씁니다. 키는 화면으로 내려가지 않습니다.
# 주의: 클라우드 공급자(openai·gemini·gemini_decision·anthropic·openrouter)를 넣으면 모든 사용자의 OCR 원문이
#       그 회사로 전송되고, 요금은 이 키 주인에게 나갑니다. 실사 개인정보 사진 시연에는 ollama 를 권합니다.
#   공급자: rules(기본, 규칙 기반) · openai · gemini · gemini_decision · anthropic · openrouter · ollama · custom
#   gemini_decision(D-23): 모델 gemini-decision-1, 키는 Gemini 와 같은 Google AI Studio 키. 추론 정도·빠른 처리 없음
PL_JUDGE_PROVIDER=rules
PL_JUDGE_MODEL=
#   추론 정도: auto(보내지 않음) 또는 공급자별 값
#   openai·custom·openrouter: none minimal low medium high xhigh max
#   anthropic: low medium high xhigh max   gemini: minimal low medium high xhigh   ollama: off on low medium high
PL_JUDGE_REASONING=auto
#   빠른 처리(요금 추가, openai·anthropic 만): true / false
PL_JUDGE_FAST=false
PL_JUDGE_API_KEY=
#   ollama(기본 http://127.0.0.1:11434) · custom(필수) 주소. 엔진 서버 기준 주소입니다.
PL_JUDGE_BASE_URL=

# ---------------------------------------------------------------- 실행·연결
# HOST=0.0.0.0                 # 다른 기기에서 게이트웨이로 접속
# PORT=8000
# PL_ENGINE_PORT=8001
# PL_GATEWAY_TOKEN=            # 게이트웨이 ↔ 엔진 공유 비밀값. 다른 PC 의 엔진을 붙이면 꼭 설정
# PL_ADMIN_KEY=                # 화면 '엔진 N대' 관리 키. 비우면 켤 때마다 새로 만들어 콘솔에 보여 줌
# PL_BACKENDS=http://192.168.0.21:8000,http://192.168.0.22:8000   # run_gateway.py 엔진 목록
# PL_CORS_ORIGINS=             # 화면을 따로 올렸을 때 그 주소(쉼표로 여러 개)
# PL_SSL_CERT=cert.pem
# PL_SSL_KEY=key.pem

# ---------------------------------------------------------------- 처리량
# PL_QUEUE_MAX=12              # 엔진 한 대 대기 한도
# PL_GATEWAY_QUEUE_MAX=24      # 게이트웨이 대기 한도
# PL_PADDLE_THREADS=           # OCR CPU 스레드 수

# ---------------------------------------------------------------- OCR·모델 (서버 PC 마다 다를 수 있음)
# PL_OCR=paddleocr             # paddleocr · tesseract · none
# PL_YOLO_WEIGHTS=models/vNNN/best.pt   # 시연 서버는 검증한 버전으로 고정 권장(D-14)
# PL_YOLO=on
# PL_DAILY_MODEL=models/daily.onnx
# PL_PLATE_MODEL=models/plate.onnx
# PL_FACES=card                # card · all · off (D-18)
# PL_FACE_ROTATE=1
# PL_PLATE_ROTATE=1
# PL_UNLABELED_NAMES=context   # off · context · all (D-12)

# ---------------------------------------------------------------- 기록
# PL_TIMING_PATH=              # 단계별 시간 기록 파일(기본 ~/.privacy-lens/timing.json)
# PL_TIMING=on                 # off 면 메모리에만
